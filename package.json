{
  "name": "treble",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "update-types": "supabase gen types typescript --project-id \"pueoumkuxzosxrzqoefw\" > types/supabase.ts.tmp && mv types/supabase.ts.tmp types/supabase.ts",
    "setup-audio-api": "bash node_modules/react-native-audio-api/scripts/download-prebuilt-binaries.sh ios android",
    "postinstall": "test -f node_modules/react-native-audio-api/scripts/download-prebuilt-binaries.sh && npm run setup-audio-api || true",
    "build-eas-sim": "eas build --profile development-simulator --platform ios",
    "build-sim": "npx expo prebuild -p ios",
    "build-ios": "eas build --profile production --platform ios",
    "submit-ios": "eas submit --platform ios"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
